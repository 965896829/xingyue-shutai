{
  "name": "wenxu-desktop",
  "version": "0.4.20",
  "private": true,
  "description": "星月书台 · 本地网文创作工作台",
  "author": "AIkehuduan",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc --noEmit",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite --host 127.0.0.1",
    "test:scale": "node --import tsx tests/scale.ts",
    "test:large-book": "node scripts/test-large-book.mjs",
    "eval:context": "node --import tsx scripts/context-eval.ts --run-context-eval"
  },
  "build": {
    "appId": "local.wenxu.desktop",
    "productName": "星月书台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/skill",
        "to": "skill"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false,
      "executableName": "星月书台"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "guid": "abaa7e0a-484b-5222-a08b-20b012130b6d",
      "shortcutName": "星月书台",
      "uninstallDisplayName": "${productName} ${version}",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "publish": null,
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@lezer/highlight": "1.2.5",
    "@xmldom/xmldom": "0.9.12",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "docx": "9.9.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "js-tiktoken": "1.0.21",
    "lucide-react": "1.52.0",
    "marked": "18.1.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mariozechner/pi-agent-core": "0.73.1",
    "@types/diff": "7.0.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
