            "ConfirmedWorldRules",
            "WorldDesignScope",
            "WorldOutputContract"
          ],
          "outputKind": "world-design-candidate",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "author.locked-constraints",
            "world.rule-consistency",
            "source.valid-refs",
            "revision.allowed-scope"
          ],
          "contextView": "author_design",
          "outputBinding": "compat_adapter"
        }
      ]
    },
    {
      "id": "character-design",
      "title": "角色内核与群像设计",
      "description": "用于建立或增补指定角色的稳定内核、关系和初始设定；不负责每章动态状态提取。",
      "coreInstructions": "让角色具备可解释的选择：长期欲望、眼前利益、不能失去之物、价值冲突、常用策略、盲点和关系中的表达方式。配角拥有自己的目的与代价，不能只为主角提供功能。声音通过注意力、说话意图和关系压力形成辨识，不强制每人都带创伤、秘密或口头禅。稳定内核、初始状态、未来计划、他人评价和模型解释分别保存。作者锁定的人格与经历不暗改，候选设定不自动成为正史。日常讨论交共创操作，章后状态由统一记忆提取处理。",
