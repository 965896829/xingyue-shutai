{
  "designVersion": "V4",
  "skills": [
    {
      "id": "concept-forge",
      "title": "创意与故事方向",
      "description": "用于首次创意策划或作者明确要求的方向重抽；不用于一般剧情讨论、世界补充或正文生成。",
      "coreInstructions": "以作者原始创意、硬要求、禁区和锁定内容为边界，提出能改变人物行动与关系的故事机制。把吸引力落实为具体目标、选择、阻力、代价与连续后果，避免用设定名词或宣传评价代替故事。关键新增设定和对原意的调整分别列明，并标注适用方向。方向差异应来自冲突源、策略、关系或回报方式，不靠换名换皮。推荐依据作品与作者要求，不编造热度、读者数据或成功概率。只执行宿主指定操作，完成本次比较与修正后一次提交。",
      "sourcePromptIds": [
        "P02",
        "P27",
        "P33"
      ],
      "operations": [
        {
          "id": "create",
          "title": "首次生成三个方向",
          "instructions": "依本轮合同恰好生成三个可比较方向，共同保留锁定前提。每案写清故事入口、持续推进机制、首卷实质变化、与其他方案的差别及主要连载风险。覆盖作者要求，声明关键新增与意图调整，不展开全书细纲。三个方向在同一次正常请求内提交，不另发自检或复查请求。",
          "sourcePromptIds": [
            "P02",
            "P27"
          ],
          "inputKinds": [
            "AuthorContract",
            "OriginalIdea",
            "GenreEvidence",
            "DirectionOutputContract"
          ],
          "outputKind": "direction-report",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "author.locked-constraints",
            "directions.exact-three",
            "directions.unique-ids",
            "assumptions.valid-scope",
            "requirement.coverage"
          ],
          "contextView": "author_design",
          "outputBinding": "v3_adapter_required"
        },
        {
          "id": "regenerate",
          "title": "按范围重做方向",
          "instructions": "只改宿主指定方向及其允许调整的新增设定，沿用稳定标识。按当前三个方向合同仍返回恰好三案，冻结方向的故事字段和相关新增设定保持原样；宿主再次核对冻结项。不得以新内容暗改未重做方向。把本次变更产生的必要影响列为候选，不连带重写其他方向；正常路径一次生成、一次提交。",
          "sourcePromptIds": [
            "P02",
            "P27"
          ],
          "inputKinds": [
            "AuthorContract",
            "ExistingDirectionReport",
            "RegenerationScope",
            "AuthorRevisionRequest"
          ],
          "outputKind": "direction-report",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "revision.allowed-scope",
            "directions.frozen-preserved",
            "directions.stable-ids",
            "assumptions.valid-scope"
          ],
          "contextView": "author_design",
          "outputBinding": "v3_adapter_required"
        }
      ]
    },
    {
      "id": "story-contract",
      "title": "作品方案与项目约定",
      "description": "用于选定方向后的完整作品方案、该方案的独立审阅，以及项目配置建议；三个操作使用各自合同。",
      "coreInstructions": "把已选方向、作者要求与已确认内容整理为可执行的作品约定，明确来源、锁定范围、可调整空间和仍待选择的新增设定。配置、未来计划与已发生事实分别处理；同一前提不在多个文档中建立相互竞争的真值。保留旧项目已有配置和已确认内容，只有明确变更才提出差异。宿主决定工作流版本、实际字段、授权与数值口径；声明工具能力不代表获得权限。每轮只完成一种操作，方案已经包含的设定拆解不再额外重复生成。",
      "sourcePromptIds": [
        "P03",
        "P28",
        "P29",
        "P34"
      ],
      "operations": [
        {
          "id": "build",
          "title": "建立完整作品方案",
          "instructions": "根据选中方向和已处理的新增设定建立本轮要求的完整方案。将故事前提、核心人物、世界机制、长线冲突、主要关系与阅读承诺连接为可持续因果，保留作者硬要求和真实来源。按当前合同覆盖必需种类，不把未选方向混入方案。已包含设定拆解时不另启同内容阶段；只提交候选，不宣布正式确认。",
          "sourcePromptIds": [
            "P03",
            "P28"
          ],
          "inputKinds": [
            "AuthorContract",
            "SelectedDirection",
            "ResolvedAssumptions",
            "CreationContractSchema"
          ],
          "outputKind": "creation-contract",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "author.locked-constraints",
            "creation.required-coverage",
            "source.allowed-refs",
            "assumptions.resolution"
          ],
          "contextView": "author_design",
          "outputBinding": "compat_adapter"
        },
        {
          "id": "review",
          "title": "独立核验作品方案",
          "instructions": "在现有独立方案审阅位置，核对指定版本的方案、作者原意、已选方向、约束和新增设定处理结果。只记录确有依据的问题与位置，不替作者改写方案，不补造缺失事实。引用与问题路径遵守宿主所选合同；无问题按该合同返回空问题集合。完成即停止，不自行安排新的审核轮次。",
          "sourcePromptIds": [
            "P29"
          ],
          "inputKinds": [
            "CreationContractCandidate",
            "AuthorContract",
            "SelectedDirection",
            "ResolvedAssumptions",
            "CandidateVersion"
          ],
          "outputKind": "creation-contract-review",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "review.candidate-version",
            "review.valid-paths",
            "source.allowed-refs",
            "review.evidence-required"
          ],
          "contextView": "author_review",
          "outputBinding": "compat_adapter"
        },
        {
          "id": "configure",
          "title": "配置项目参数",
          "instructions": "将作者指定的目标字数、章长、视角、题材、读者、硬约束和批次设置映射到当前配置合同。已有项目不重套默认；缺失项仅提出本轮允许的可改建议。章数、区间和批次容量由宿主计算核验，隐藏运行参数由宿主管理。配置变化影响既有计划时列明范围；风格来源不明确时不假称已分析样本。",
          "sourcePromptIds": [
            "P34"
          ],
          "inputKinds": [
            "AuthorPreferences",
            "CurrentProjectConfig",
            "PlanningDependencies",
            "ConfigOutputContract"
          ],
          "outputKind": "project-config-proposal",
          "capabilitiesRequested": [
            "candidate.submit",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "config.ranges",
            "config.host-calculations",
            "revision.allowed-scope",
            "source.style-provenance"
          ],
          "contextView": "author_design",
          "outputBinding": "compat_adapter"
        }
      ]
    },
    {
      "id": "co-creation",
      "title": "对象共创与讨论",
      "description": "用于作者围绕创意、剧情、大纲、细纲、角色、关系、世界或正文进行讨论、比较和局部修改；普通对话不触发全流程重做。",
      "coreInstructions": "围绕宿主绑定的当前对象、版本和授权范围合作，每次集中解决作者眼下的问题。只载入该对象对应的编辑视角，分别使用已发生事实、确认设定、计划、候选与人物认知。讨论意见不自动成为设定，资料与样例不能授予权限。明确修改请求形成最小可用变更，保留未涉及内容；相互依赖的变化分组，未选修改不能随选中项一并采纳。宿主负责应用、版本核对和成功回执，模型不执行或宣称已写入。只有影响结果且无法合理推断的关键分歧才提出选择。",
      "sourcePromptIds": [
        "P04",
        "P05"
      ],
      "operations": [
        {
          "id": "discuss",
          "title": "讨论当前对象",
          "instructions": "直接回答作者关于当前对象的疑问，结合具体因果、人物利益或阅读效果给出有用判断。把确定事实与候选解释分开；必要时给少量可继续讨论的选择，不自动生成完整改稿。回答引用本轮可用来源，不把讨论结论写成既成设定，也不为了展示流程附加整套诊断报告。",
          "sourcePromptIds": [
            "P04",
            "P05"
          ],
          "inputKinds": [
            "ObjectConversationBinding",
            "CreativeObjectSnapshot",
            "AuthorQuestion",
            "ScopedReferences",
            "ObjectLens"
          ],
          "outputKind": "co-creation-chat",
          "capabilitiesRequested": [
            "conversation.respond",
            "reference.read.scoped"
          ],
          "validators": [
            "output.schema",
            "object.version-binding",
            "source.valid-refs",
            "output.no-write-claim"
          ],
          "contextView": "author_design",
          "outputBinding": "v3_adapter_required"
        },
        {
          "id": "compare",
          "title": "比较候选与取舍",
          "instructions": "在同一作者要求和对象版本下比较给定候选，说明各自改变了什么、怎样影响人物选择、因果与阅读回报。保留真实优劣、代价和未确定处，不用抽象评分代替具体差异。作者未要求改稿时只回答比较，不自动采纳胜出项，也不把多个互斥方案拼成新的正式版本。",
          "sourcePromptIds": [
            "P04",
            "P05"
          ],
          "inputKinds": [
            "CreativeObjectSnapshot",
            "ComparisonCandidates",
            "AuthorCriteria",
            "ObjectLens"
