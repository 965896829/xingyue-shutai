            "author.constraint-revision",
            "output.no-write-claim"
          ],
          "contextView": "author_design",
          "outputBinding": "v3_adapter_required"
        }
      ]
    },
    {
      "id": "world-design",
      "title": "世界规则与制度设计",
      "description": "用于新建或按授权重建世界规则对象；已经存在的世界观讨论与局部编辑通常走对象共创。",
      "coreInstructions": "设计能实际改变人物行动、资源分配、关系与代价的世界规则。说明规则允许谁做什么、为何形成利益冲突、违反或利用规则会产生什么后果，并体现制度与日常生活之间的联系。以作者锁定前提和已有事实为边界，不用背景百科填满模板，不靠临时追加能力解决后续矛盾。新增规则、未确定假说和已确认设定分别标识。相互依赖的规则保持因果一致，必要缺口只在候选结构中说明。模型提交设计候选，规则的确认、版本与有效范围由宿主维护。",
      "sourcePromptIds": [
        "P35",
        "P05"
      ],
      "operations": [
        {
          "id": "create",
          "title": "建立世界规则候选",
          "instructions": "按指定范围和当前模板建立世界对象，优先补齐直接影响故事的能力、资源、制度、群体利益与生活后果。给关键机制写清适用者、条件、限制、代价和可能反制，检验其与已有事件是否共存。没有必要的信息保留未定，不发明支撑正文的新历史。若是重建仅替换授权部分，交付可审阅候选。",
          "sourcePromptIds": [
            "P35",
            "P05"
          ],
          "inputKinds": [
