          ],
          "contextView": "author_design",
          "outputBinding": "v3_adapter_required"
        },
        {
          "id": "propose",
          "title": "提出局部变更",
          "instructions": "依据作者明确要求生成绑定当前版本的变更候选，标明修改、保留项、依赖组和具体影响。未来变化、纠错与追溯改设定分别表达；改变旧锁定要求须有本轮作者依据。关联对象超出授权时仅列影响，不代改。不要重复询问已经明确的授权；应用、部分采纳和回滚由宿主执行。",
          "sourcePromptIds": [
            "P04",
            "P05"
          ],
          "inputKinds": [
