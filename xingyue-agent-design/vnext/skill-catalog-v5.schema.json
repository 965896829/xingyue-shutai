{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:xingyue:skill-catalog:v5-design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "designVersion",
    "skills"
  ],
  "properties": {
    "designVersion": {
      "const": "V5"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/skill"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:P(?:0[1-9]|[1-4][0-9]|5[0-7])|V5P(?:0[1-9]|1[0-9]|2[01]))$"
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "coreInstructions",
        "sourcePromptIds",
        "operations"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "coreInstructions": {
          "$ref": "#/definitions/text"
        },
        "sourcePromptIds": {
          "$ref": "#/definitions/prompts"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "instructions",
        "sourcePromptIds",
        "inputKinds",
        "outputKind",
        "capabilitiesRequested",
        "validators",
        "contextView",
        "outputBinding"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "instructions": {
          "$ref": "#/definitions/text"
        },
        "sourcePromptIds": {
          "$ref": "#/definitions/prompts"
        },
        "inputKinds": {
          "$ref": "#/definitions/strings"
        },
        "outputKind": {
          "$ref": "#/definitions/id"
        },
        "capabilitiesRequested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate.submit",
              "memory.query.scoped",
              "reference.read.scoped",
              "evidence.search.public",
              "prose.return",
              "conversation.respond"
            ]
          }
        },
        "validators": {
          "$ref": "#/definitions/strings"
        },
        "contextView": {
          "enum": [
            "author_design",
            "scoped_pov",
            "author_review",
            "scoped_query"
          ]
        },
        "outputBinding": {
          "enum": [
            "compat_adapter",
            "v3_adapter_required",
            "v4_adapter_required",
            "v5_adapter_required"
          ]
        },
        "targetBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetKind",
              "additionalInputKinds",
              "additionalValidators"
            ],
            "properties": {
              "targetKind": {
                "enum": [
                  "entity_name",
                  "book_title",
                  "blurb"
                ]
              },
              "additionalInputKinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalValidators": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
