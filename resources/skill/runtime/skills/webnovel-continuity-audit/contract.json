  "outputs": [
    "连续性问题清单",
    "待回查来源与受影响依赖"
  ],
  "acceptance_criteria": [
    "矛盾有双向来源定位",
    "不确定性明确",
    "真相/谎言/计划隔离",
    "没有审阅即擅改"
  ],
  "execution": {
    "trigger": "正常阶段 guard 的宿主调度",
