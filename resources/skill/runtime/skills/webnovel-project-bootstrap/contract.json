{
  "contract_version": "1.0",
  "stage": "bootstrap",
  "optional": false,
  "tools": [
    "project.read_snapshot",
    "artifact.read",
    "memory.query",
    "memory.trace_source",
    "skill.load",
    "candidate.write",
    "candidate.diff",
    "changeset.propose",
    "validate.run",
    "review.request"
  ],
  "write_scope": "candidate-only",
  "can_approve": false,
  "can_commit": false,
  "can_publish": false,
  "requires_consistent_snapshot": true,
  "max_repairs": 2,
  "inputs": "用户项目位置、标题或临时名；宿主工作区边界；已有文件实查结果；配置及导入授权。",
  "outputs": [
    "项目manifest候选",
    "中文档案目录候选及阶段索引",
    "导入/迁移差异报告"
  ],
  "acceptance_criteria": [
    "重复执行不覆盖已存在正文",
    "无原文不生成故事事实",
    "scaffold阶段零已接受章允许通过",
    "命名空间、路径边界与源hash完整"
  ]
}
