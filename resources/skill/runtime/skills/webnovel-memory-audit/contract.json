{
  "contract_version": "2.0",
  "stage": "optional",
  "optional": true,
  "tools": [
    "read_naming_rules",
    "read_document",
    "search_memory",
    "propose_changes",
    "propose_memory",
    "validate",
    "ask_author"
  ],
  "write_scope": "candidate-only",
  "can_approve": false,
  "can_commit": false,
  "can_publish": false,
  "requires_consistent_snapshot": true,
  "max_repairs": 2,
  "inputs": "宿主快照与来源、角色或场景、授权预算和量表/审计规则版本",
  "outputs": [
    "memory_audit_report",
    "missing_dependencies",
    "candidate_repairs"
  ],
  "acceptance_criteria": [
    "所有观点或数值有原文依据或明确未知",
    "版本与POV匹配",
    "模型输出不修改正史",
    "显示边界与评估局限"
  ]
}
