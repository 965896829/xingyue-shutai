{
  "contract_version": "1.0",
  "stage": "guard",
  "optional": false,
  "tools": [
    "project.read_snapshot",
    "artifact.read",
    "memory.query",
    "memory.trace_source",
    "skill.load",
    "candidate.write",
    "candidate.diff",
    "changeset.propose",
    "validate.run",
    "review.request"
  ],
  "write_scope": "candidate-only",
  "can_approve": false,
  "can_commit": false,
  "can_publish": false,
  "requires_consistent_snapshot": true,
  "max_repairs": 2,
  "inputs": "命名对象类型、时代/地域/文化、世界/时间线、命名者、实体ID、确认状态、视角知情、禁用约定。",
  "outputs": [
    "名称候选或审阅报告",
    "实体别名台账差异",
    "必要的改名changeset提案"
  ],
  "acceptance_criteria": [
    "无示例污染",
    "旧稿未经授权不改",
    "混合世界分别路由",
    "历史别名和不知情角色称呼不乱替换"
  ]
}
