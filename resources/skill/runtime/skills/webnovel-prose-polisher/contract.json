{
  "contract_version": "1.0",
  "stage": "S10/revision",
  "optional": false,
  "tools": [
    "project.read_snapshot",
    "artifact.read",
    "memory.query",
    "memory.trace_source",
    "skill.load",
    "candidate.write",
    "candidate.diff",
    "changeset.propose",
    "validate.run",
    "review.request"
  ],
  "write_scope": "candidate-only",
  "can_approve": false,
  "can_commit": false,
  "can_publish": false,
  "requires_consistent_snapshot": true,
  "max_repairs": 2,
  "inputs": "待改候选或已授权版本、事实清单、启用文风、具体审阅项、字数范围与禁止变化区域。",
  "outputs": [
    "润色候选版本",
    "事实保持检查与字数差异"
  ],
  "acceptance_criteria": [
    "事实/POV/知情未暗改",
    "必要解释仍在",
    "用户文风保留",
    "不能覆盖后续作者手稿"
  ]
}
