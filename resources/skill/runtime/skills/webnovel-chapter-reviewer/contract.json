{
  "contract_version": "1.0",
  "stage": "S10/guard",
  "optional": false,
  "tools": [
    "project.read_snapshot",
    "artifact.read",
    "memory.query",
    "memory.trace_source",
    "skill.load",
    "candidate.write",
    "candidate.diff",
    "changeset.propose",
    "validate.run",
